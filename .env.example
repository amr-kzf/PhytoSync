# Copy this file to .env. Keep .env private and never commit real credentials.
# Generate a unique session key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///biogrow.db

# Optional hosted chatbot
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional live weather and email/OTP delivery
STORMGLASS_API_KEY=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional official disease-model artifact paths
PHYTOSYNC_WEIGHTS=artifacts/current/best_model.pt
PHYTOSYNC_CLASS_NAMES=artifacts/current/class_names.json
